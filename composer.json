{
    "name": "boa/previews",
    "description": "Boatrace Open API for Previews",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "shimomo",
            "email": "boa@shimomo.net"
        }
    ],
    "support": {
        "issues": "https://github.com/boatraceopenapi/previews/issues",
        "source": "https://github.com/boatraceopenapi/previews"
    },
    "require": {
        "php": "^8.4",
        "bvp/scraper": "^6.0",
        "nesbot/carbon": "^2.63 || ^3.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.52",
        "phpunit/phpunit": "^13.0",
        "vimeo/psalm": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "BOA\\Previews\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BOA\\Previews\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        }
    },
    "$schema": "https://getcomposer.org/schema.json"
}
